# PORT=6111
NODE_ENV=production

# -- Database connection options
DB_HOST=localhost
# DB_PORT=5432
DB_USER=postgres
DB_PASS=password
# DB_NAME=url_shortener

# -- OIDC login for /admin (optional: leave all of these empty to disable auth)
# uses https://<NEXT_PUBLIC_DOMAIN> as the app URL for redirects
# OIDC_URL=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_SCOPE=openid profile email

# -- Role mapping (optional: when any of the three is left unset or empty,
# every logged in user is treated as an admin)
# ROLES_CLAIM is the ID token / userinfo claim carrying the user's roles, its
# value can be a single role or a list of them. ROLE_ADMIN and ROLE_VIEWER are
# the claim values mapped to the internal roles: admins can read and modify,
# viewers can only read. A user carrying neither role gets no access.
# ROLES_CLAIM=roles
# ROLE_ADMIN=url-shortener-admin
# ROLE_VIEWER=url-shortener-viewer
