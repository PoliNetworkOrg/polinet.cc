# PORT=6111
NODE_ENV=production

# -- Database connection options
DB_HOST=localhost
# DB_PORT=5432
DB_USER=postgres
DB_PASS=password
# DB_NAME=url_shortener

# -- OIDC login for /admin (optional: leave all of these empty to disable auth)
# uses https://<NEXT_PUBLIC_DOMAIN> as the app URL for redirects
# NEXT_PUBLIC_OIDC_URL=https://auth.example.com
# NEXT_PUBLIC_OIDC_CLIENT_ID=
# PoliNetwork auth requires polinetwork:identity for membership authorization.
# NEXT_PUBLIC_OIDC_SCOPE=openid profile email polinetwork:identity
# Generate with: openssl rand -base64 48
# SESSION_SECRET=some-random-string-of-at-least-32-characters-long

# -- Role mapping (optional: when any of the three is left unset or empty,
# every logged in user is treated as an admin)
# ROLES_CLAIM is the ID token / UserInfo claim carrying roles. Its value can be
# a single role, a list, or an object with a permissions list. ROLE_ADMIN and
# ROLE_VIEWER map those values to this application's roles. A user carrying
# neither value gets no access. The PoliNetwork claim key follows
# BETTER_AUTH_URL, so update it in non-production environments.
# ROLES_CLAIM=https://auth.polinetwork.org/api/identity
# ROLE_ADMIN=membership:read
# ROLE_VIEWER=student:verified
