# PORT=6111
NODE_ENV=production

# -- Database connection options
DB_HOST=localhost
# DB_PORT=5432
DB_USER=postgres
DB_PASS=password
# DB_NAME=url_shortener

# -- Click analytics
# Secret used to derive the daily, one-way visitor hash for unique-click
# estimates. Keep it secret and stable; generate with `openssl rand -hex 32`.
ANALYTICS_HASH_SECRET=change-me-to-a-random-32-byte-secret
# Optional: name of the trusted proxy/CDN header carrying the visitor's
# country (e.g. "cf-ipcountry"). Leave unset to use the built-in Cloudflare/
# Vercel header names.
# GEO_COUNTRY_HEADER=cf-ipcountry
# Optional: name of the trusted proxy/CDN header carrying the visitor's real
# IP (e.g. "cf-connecting-ip"). Used only transiently to derive the daily
# unique-visitor hash — never stored or logged. Leave unset to use the
# built-in Cloudflare/Vercel header names.
# TRUSTED_IP_HEADER=cf-connecting-ip
# Optional: bearer token required by GET /api/cron/purge-analytics-dedup
# (called on a schedule — see .github/workflows/purge-analytics-dedup.yml —
# to guarantee the dedup retention window even for links that stop getting
# clicks). Leave unset to allow that endpoint to be called without auth.
# CRON_SECRET=change-me-to-a-random-32-byte-secret

