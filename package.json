{
  "name": "polinet.cc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6111",
    "build": "SKIP_ENV_VALIDATION=true next build",
    "build:analyze": "SKIP_ENV_VALIDATION=true next experimental-analyze --output",
    "prestart": "mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "check": "biome check",
    "check:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "docker:build": "docker build -t tmsu-cc .",
    "docker:run": "docker run -p 6111:6111 tmsu-cc",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f app"
  },
  "dependencies": {
