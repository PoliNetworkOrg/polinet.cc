    "@ts-rest/open-api": "3.53.0-rc.1",
    "@ts-rest/serverless": "3.53.0-rc.1",
    "@types/pg": "^8.23.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
